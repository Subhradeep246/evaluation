# Copy this file to .env and adjust as needed.

# Path to a dedicated Chromium user-data folder. The first run opens a browser
# here so you can log in manually; the session then persists across runs.
# Relative paths are resolved against the dopple_automation/ folder.
DOPPLE_PROFILE_DIR=browser_profile

# Optional: explicit path to your chrome.exe / chromium binary.
# Leave blank to let DrissionPage auto-detect the system browser.
# Example (Windows): C:\Program Files\Google\Chrome\Application\chrome.exe
DOPPLE_BROWSER_PATH=

# Local CDP port DrissionPage uses to control the dedicated browser.
DOPPLE_LOCAL_PORT=9333

# Character details (used when DOPPLE_RANDOMIZE=0).
DOPPLE_CHARACTER_NAME=Aria Nightingale
DOPPLE_CHARACTER_TAGLINE=A witty starship navigator who loves riddles
DOPPLE_CHARACTER_GREETING=Welcome aboard, traveler. Where are we charting a course to today?

# Randomize name, bio, dropdowns, image colors, and chat prompts each run (default: on).
DOPPLE_RANDOMIZE=1
# Optional: set for reproducible random specs, e.g. DOPPLE_RANDOM_SEED=42
# DOPPLE_RANDOM_SEED=

# Output transcript file (relative to dopple_automation/).
DOPPLE_OUTPUT_FILE=dopple_conversation.json
